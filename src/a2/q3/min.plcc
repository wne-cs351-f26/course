# LONN: a non-empty List Of Natural Numbers, in parentheses.
# Meaning: the smallest number in the list.
skip  WS     '\s+'
token LPAREN '\('
token RPAREN '\)'
token NUM    '\d+'
%
<Lonn>       ::= LPAREN <NUM> <Nums> RPAREN
<Nums:More>  ::= <NUM> <Nums>
<Nums:Done>  ::=
%
Python

Lonn
%%%
def _run(self):
    first = int(self.num.lexeme)
    return str(self.nums.min(first))
%%%

More
%%%
def min(self, best):
    n = int(self.num.lexeme)
    if n < best:
        best = n
    return self.nums.min(best)
%%%

Done
%%%
def min(self, best):
    return best
%%%
