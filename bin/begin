#!/usr/bin/env bash
# Copy an assignment's starter files into the student's repository and
# record a pristine baseline.
#
# The baseline is a filesystem copy under .cs351/pristine/, not a git
# commit, so that recording it does not depend on the repository being in
# a clean state. The commit is best-effort on top of that.
set -euo pipefail

BEGIN_BRANCH="${BEGIN_BRANCH:-main}"
CS351_REPO_ROOT="${CS351_REPO_ROOT:-$PWD}"
CS351_COURSE="${CS351_COURSE:-$HOME/.local/share/cs351/course}"

# Resolve our own real location (begin is symlinked onto PATH from
# ~/.local/bin, so BASH_SOURCE alone would point at the symlink's
# directory, not here) so we can find the shared library next to us.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
source "$(dirname "${_self}")/.cs351-lib.bash"


main() {
    if [[ $# -lt 1 ]]; then
        display-usage
        return 0
    fi

    FORCE=False
    if [[ "${1}" == "-f" ]]; then
        FORCE=True
        shift
    fi

    if [[ $# -lt 1 ]]; then
        display-usage
        return 0
    fi

    ASSIGNMENT="${1}"

    assert-repo-usable

    update-course

    local source="${CS351_COURSE}/src/${ASSIGNMENT}"
    if [[ ! -d "${source}" ]]; then
        >&2 echo "ERROR: No such assignment: ${ASSIGNMENT}"
        >&2 echo ""
        >&2 echo "Available assignments:"
        >&2 list-assignments
        return 1
    fi

    # Refuse anything not yet released. An unreleased assignment may still
    # change, and begin copies rather than tracks, so a student who started
    # early would work against a moving target with no way to be notified.
    if ! is-released "${ASSIGNMENT}"; then
        >&2 echo "ERROR: ${ASSIGNMENT} has not been released yet."
        >&2 echo ""
        >&2 echo "It may still change before it is assigned, so starting it now"
        >&2 echo "could mean redoing your work. Nothing has been changed."
        >&2 echo ""
        >&2 echo "Available now:"
        >&2 list-assignments
        return 1
    fi

    local dest="${CS351_REPO_ROOT}/${ASSIGNMENT}"
    if [[ -e "${dest}" && "${FORCE}" != "True" ]]; then
        >&2 echo "ERROR: ${ASSIGNMENT} already exists in your repository."
        >&2 echo "Use 'begin -f ${ASSIGNMENT}' to overwrite it."
        >&2 echo "WARNING: -f discards your changes to those files."
        return 1
    fi

    cp -R "${source}" "${CS351_REPO_ROOT}/"
    record-pristine "${ASSIGNMENT}"
    commit-pristine "${ASSIGNMENT}" || warn-commit-failed "${ASSIGNMENT}"

    echo "Started ${ASSIGNMENT}. Edit the files in ${ASSIGNMENT}/, then run 'save'."
}


# Refuse before touching any files if the repository is mid-merge or
# mid-rebase. Committing is impossible in that state, and a student is
# not equipped to resolve it under time pressure.
assert-repo-usable() {
    if ! cs351_is_git_repo "${CS351_REPO_ROOT}"; then
        >&2 echo "ERROR: ${CS351_REPO_ROOT} is not a git repository."
        return 1
    fi

    if cs351_repo_has_unfinished_merge "${CS351_REPO_ROOT}"; then
        >&2 echo "ERROR: Your repository has an unfinished merge."
        >&2 echo ""
        >&2 echo "Nothing has been changed. Please show this message to your"
        >&2 echo "instructor -- do not try to fix it yourself."
        return 1
    fi
}


# Both failure modes here get a student-facing message and suppressed raw
# git chatter, but they differ in severity: a checkout failure (e.g. a
# misconfigured BEGIN_BRANCH) means we cannot trust anything under
# CS351_COURSE/src, so it is fatal. A failed pull just means the content on
# disk might be stale -- worth a loud warning, but stale files still beat
# no files, so it is not fatal.
update-course() {
    if ! git -C "${CS351_COURSE}" checkout --quiet "${BEGIN_BRANCH}" >/dev/null 2>&1; then
        >&2 echo "ERROR: Could not switch course materials to branch '${BEGIN_BRANCH}'."
        >&2 echo ""
        >&2 echo "Nothing has been changed. Please show this message to your"
        >&2 echo "instructor -- do not try to fix it yourself."
        return 1
    fi

    if ! git -C "${CS351_COURSE}" pull --quiet --ff-only >/dev/null 2>&1; then
        >&2 echo "WARNING: Could not refresh course materials (no network, or the"
        >&2 echo "course repository could not be fast-forwarded)."
        >&2 echo "Continuing with what is already on disk -- your assignment files"
        >&2 echo "may be out of date. If something looks wrong, tell your instructor."
    fi
}


record-pristine() {
    local assignment="${1}"
    local pristine="${CS351_REPO_ROOT}/.cs351/pristine/${assignment}"
    rm -rf "${pristine}"
    mkdir -p "$(dirname "${pristine}")"
    cp -R "${CS351_COURSE}/src/${assignment}" "${pristine}"
}


commit-pristine() {
    local assignment="${1}"
    git -C "${CS351_REPO_ROOT}" add \
        "${assignment}" ".cs351/pristine/${assignment}" \
        && git -C "${CS351_REPO_ROOT}" commit --quiet --only \
            "${assignment}" ".cs351/pristine/${assignment}" \
            -m "chore: begin ${assignment}"
}


warn-commit-failed() {
    >&2 echo "NOTE: Could not commit the starter files for ${1}."
    >&2 echo "Your files were copied successfully. Run 'save' when ready."
}


display-usage() {
    >&2 echo "
begin [-f] ASSIGNMENT

    Copies the starter files for ASSIGNMENT into your repository.

    Refuses if ASSIGNMENT already exists, unless -f is given.
    -f overwrites, discarding your changes to those files.

Available assignments:

$(list-assignments)
"
}


# Names listed in the course repository's released.txt, one per line, with
# comments and blank lines stripped.
released-items() {
    local manifest="${CS351_COURSE}/released.txt"
    [[ -f "${manifest}" ]] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "${manifest}" \
        | grep -v '^$'
}


is-released() {
    released-items | grep -qx -- "${1}"
}


list-assignments() {
    local out
    out="$(released-items)"
    if [[ -z "${out}" ]]; then
        echo "(nothing released yet -- ask your instructor if you expected something)"
    else
        echo "${out}"
    fi
}


if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
