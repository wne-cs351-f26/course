#!/usr/bin/env bash
# Copy an assignment's starter files into the student's repository and
# record a pristine baseline.
#
# The baseline is a filesystem copy under .cs351/pristine/, not a git
# commit, so that recording it does not depend on the repository being in
# a clean state. The commit is best-effort on top of that.
# Everything below is wrapped in a brace group so that bash parses the whole
# file before executing any of it.
#
# bash reads a script incrementally, in blocks, and keeps its file offset.
# `begin` pulls the course repository, and it lives *in* that repository --
# so a pull can rewrite this very file mid-run. git rewrites in place rather
# than replacing the inode (verified), so the running shell's descriptor
# points at the new bytes and the next read resumes at an offset into
# different content. The observed effect is a run that executes half the old
# version and half the new one; with the offset landing mid-token it is a
# syntax error instead.
#
# The brace group makes bash read to the closing brace before running
# anything, so a rewrite mid-run cannot affect the invocation in flight.
# Nothing is indented into it, to keep the diff honest.
{
set -euo pipefail

BEGIN_BRANCH="${BEGIN_BRANCH:-main}"
CS351_REPO_ROOT="${CS351_REPO_ROOT:-$PWD}"
CS351_COURSE="${CS351_COURSE:-$HOME/.local/share/cs351/course}"

# Resolve our own real location (begin is symlinked onto PATH from
# ~/.local/bin, so BASH_SOURCE alone would point at the symlink's
# directory, not here) so we can find the shared library next to us.
_self="$(readlink -f "${BASH_SOURCE[0]}")"
source "$(dirname "${_self}")/.cs351-lib.bash"


main() {
    FORCE=False
    if [[ "${1:-}" == "-f" ]]; then
        FORCE=True
        shift
    fi

    # Listing refreshes too. It is read-only, so it does not need a usable
    # repository -- but it does need current course materials. Without this it
    # reports whatever released.txt happened to be on disk from the last run,
    # which hides a newly released assignment from exactly the student who ran
    # `begin` to find out what is available. released.txt promises that adding
    # a line and pushing takes effect on the next run with no action from
    # students; that promise has to hold on this path as well.
    if [[ $# -lt 1 ]]; then
        update-course
        sync-infrastructure
        display-usage
        return 0
    fi

    ASSIGNMENT="${1}"

    assert-repo-usable

    update-course

    local source="${CS351_COURSE}/src/${ASSIGNMENT}"
    if [[ ! -d "${source}" ]]; then
        >&2 echo "ERROR: No such assignment: ${ASSIGNMENT}"
        >&2 echo ""
        >&2 echo "Available assignments:"
        >&2 list-assignments
        return 1
    fi

    # Refuse anything not yet released. An unreleased assignment may still
    # change, and begin copies rather than tracks, so a student who started
    # early would work against a moving target with no way to be notified.
    if ! is-released "${ASSIGNMENT}"; then
        >&2 echo "ERROR: ${ASSIGNMENT} has not been released yet."
        >&2 echo ""
        >&2 echo "It may still change before it is assigned, so starting it now"
        >&2 echo "could mean redoing your work. Nothing has been changed."
        >&2 echo ""
        >&2 echo "Available now:"
        >&2 list-assignments
        return 1
    fi

    # After the refusals above, which promise "Nothing has been changed."
    sync-infrastructure

    local dest="${CS351_REPO_ROOT}/src/${ASSIGNMENT}"
    if [[ -e "${dest}" && "${FORCE}" != "True" ]]; then
        >&2 echo "ERROR: ${ASSIGNMENT} already exists in your repository."
        >&2 echo "Use 'begin -f ${ASSIGNMENT}' to overwrite it."
        >&2 echo "WARNING: -f replaces the whole ${ASSIGNMENT}/ directory,"
        >&2 echo "discarding everything in it."
        return 1
    fi

    # Replace rather than merge. `cp -R` into an existing directory leaves the
    # previous version's files behind: when a1 was rebuilt from six questions
    # to three, `begin -f` kept q1, q2, q7, q8 and q9 next to the new q3, while
    # record-pristine below (which does rm -rf) correctly held only the new
    # files -- so the working copy and the baseline disagreed about what the
    # assignment even was.
    rm -rf "${dest}"
    mkdir -p "${CS351_REPO_ROOT}/src"
    cp -R "${source}" "${CS351_REPO_ROOT}/src/"
    record-pristine "${ASSIGNMENT}"
    commit-pristine "${ASSIGNMENT}" || warn-commit-failed "${ASSIGNMENT}"

    echo "Started ${ASSIGNMENT}. Edit the files in src/${ASSIGNMENT}/, then run 'save'."
}


# Refuse before touching any files if the repository is mid-merge or
# mid-rebase. Committing is impossible in that state, and a student is
# not equipped to resolve it under time pressure.
assert-repo-usable() {
    if ! cs351_is_git_repo "${CS351_REPO_ROOT}"; then
        >&2 echo "ERROR: ${CS351_REPO_ROOT} is not a git repository."
        return 1
    fi

    if cs351_repo_has_unfinished_merge "${CS351_REPO_ROOT}"; then
        >&2 echo "ERROR: Your repository has an unfinished merge."
        >&2 echo ""
        >&2 echo "Nothing has been changed. Please show this message to your"
        >&2 echo "instructor -- do not try to fix it yourself."
        return 1
    fi
}


# Both failure modes here get a student-facing message and suppressed raw
# git chatter, but they differ in severity: a checkout failure (e.g. a
# misconfigured BEGIN_BRANCH) means we cannot trust anything under
# CS351_COURSE/src, so it is fatal. A failed pull just means the content on
# disk might be stale -- worth a loud warning, but stale files still beat
# no files, so it is not fatal.
update-course() {
    if ! git -C "${CS351_COURSE}" checkout --quiet "${BEGIN_BRANCH}" >/dev/null 2>&1; then
        >&2 echo "ERROR: Could not switch course materials to branch '${BEGIN_BRANCH}'."
        >&2 echo ""
        >&2 echo "Nothing has been changed. Please show this message to your"
        >&2 echo "instructor -- do not try to fix it yourself."
        return 1
    fi

    if ! git -C "${CS351_COURSE}" pull --quiet --ff-only >/dev/null 2>&1; then
        >&2 echo "WARNING: Could not refresh course materials (no network, or the"
        >&2 echo "course repository could not be fast-forwarded)."
        >&2 echo "Continuing with what is already on disk -- your assignment files"
        >&2 echo "may be out of date. If something looks wrong, tell your instructor."
    fi
}


# Copy the course-controlled files into the student's repository.
#
# Everything in infra/ belongs to the course: the devcontainer, editor config,
# .gitignore, the repository README, WORKFLOW.md and GRADING.md. It refreshes on
# every run, so a correction made in the course repository reaches every student
# the next time they run begin -- which is the question the old arrangement had
# no answer to, because template/ was copied once at repository creation.
#
# Student work lives under src/ and is never written here. The two namespaces
# are disjoint, so a mistake in this function cannot reach a student's work.
#
# Files removed from infra/ upstream are NOT deleted downstream. The blast
# radius of a mirror bug is every student repository at once, while the cost of
# an orphan is a stale file nobody reads.
sync-infrastructure() {
    local infra="${CS351_COURSE}/infra"
    [[ -d "${infra}" ]] || return 0

    # Sync writes files, so it must not run on a repository that cannot be
    # written to safely. Bare `begin` deliberately does not call
    # assert-repo-usable -- a read-only query should still answer when a
    # student's repository is broken -- so this is the only check on that path.
    if ! cs351_is_git_repo "${CS351_REPO_ROOT}" \
        || cs351_repo_has_unfinished_merge "${CS351_REPO_ROOT}"; then
        >&2 echo "NOTE: Course files were not updated -- your repository is not in a"
        >&2 echo "state it is safe to write to. Your own work is untouched."
        return 0
    fi

    # ONE list drives both the copy and the staging, and src is not on it.
    # That is what makes disjointness a property of this code rather than a rule
    # to remember: copying the whole of infra/ in one `cp -R "${infra}/."` would
    # MERGE a stray infra/src/ into the student's own src/, and `git add -- src`
    # would then sweep their uncommitted work into a commit labelled as ours.
    local -a entries=()
    local entry
    while IFS= read -r entry; do
        case "${entry}" in
            '' | src | .git) continue ;;
        esac
        entries+=("${entry}")
    done < <(cd "${infra}" && find . -mindepth 1 -maxdepth 1 -printf '%P\n' | sort)
    [[ ${#entries[@]} -gt 0 ]] || return 0

    # cp is a bare command under `set -e`; an unwritable destination would kill
    # begin outright, and the listing path in particular has to keep answering.
    for entry in "${entries[@]}"; do
        if ! cp -R "${infra}/${entry}" "${CS351_REPO_ROOT}/" 2>/dev/null; then
            >&2 echo "NOTE: Course files could not be updated. Your own work is"
            >&2 echo "untouched. Tell your instructor if this keeps happening."
            return 0
        fi
    done

    # Do not swallow a staging failure: that would leave files copied and
    # partially staged with nothing said, which is the state committing here is
    # meant to prevent -- save's `git add .` would later commit them as though
    # they were the student's work.
    if ! git -C "${CS351_REPO_ROOT}" add -- "${entries[@]}" >/dev/null 2>&1; then
        >&2 echo "NOTE: Course files were updated but could not be staged."
        >&2 echo "Your own work is untouched. Tell your instructor if this keeps"
        >&2 echo "happening."
        return 0
    fi

    if git -C "${CS351_REPO_ROOT}" diff --cached --quiet -- "${entries[@]}"; then
        return 0
    fi
    git -C "${CS351_REPO_ROOT}" commit --quiet --only "${entries[@]}" \
        -m "chore: update course files" >/dev/null 2>&1 \
        || >&2 echo "NOTE: Course files were updated but could not be committed."
}


record-pristine() {
    local assignment="${1}"
    local pristine="${CS351_REPO_ROOT}/.cs351/pristine/${assignment}"
    rm -rf "${pristine}"
    mkdir -p "$(dirname "${pristine}")"
    cp -R "${CS351_COURSE}/src/${assignment}" "${pristine}"
}


commit-pristine() {
    local assignment="${1}"
    local paths=("src/${assignment}" ".cs351/pristine/${assignment}")

    git -C "${CS351_REPO_ROOT}" add "${paths[@]}" >/dev/null 2>&1 || return 1

    # Re-running begin when nothing upstream changed stages nothing, and git
    # commit exits non-zero for that. It is the ordinary case rather than a
    # failure -- the files are in place and already committed -- so report
    # success. Without this the student saw a NOTE claiming the commit failed.
    if git -C "${CS351_REPO_ROOT}" diff --cached --quiet -- "${paths[@]}"; then
        return 0
    fi

    # git prints "nothing to commit" and friends on stdout, not stderr, so it
    # lands in the middle of our own messages. Suppress both streams here the
    # way update-course does; warn-commit-failed carries the student-facing
    # message if this genuinely fails.
    git -C "${CS351_REPO_ROOT}" commit --quiet --only "${paths[@]}" \
        -m "chore: begin ${assignment}" >/dev/null 2>&1
}


warn-commit-failed() {
    >&2 echo "NOTE: Could not commit the starter files for ${1}."
    >&2 echo "Your files were copied successfully. Run 'save' when ready."
}


display-usage() {
    >&2 echo "
begin [-f] ASSIGNMENT

    Copies the starter files for ASSIGNMENT into your repository.

    Refuses if ASSIGNMENT already exists, unless -f is given.
    -f replaces the whole directory, discarding everything in it.

Available assignments:

$(list-assignments)
"
}


# Names listed in the course repository's released.txt, one per line, with
# comments and blank lines stripped.
released-items() {
    local manifest="${CS351_COURSE}/released.txt"
    [[ -f "${manifest}" ]] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "${manifest}" \
        | grep -v '^$'
}


is-released() {
    released-items | grep -qx -- "${1}"
}


list-assignments() {
    local out
    out="$(released-items)"
    if [[ -z "${out}" ]]; then
        echo "(nothing released yet -- ask your instructor if you expected something)"
    else
        echo "${out}"
    fi
}


if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
}
